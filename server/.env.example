# Template only: copy to server/.env and fill in. server/.env is git-ignored: never commit keys.

PORT=3001

# MongoDB: local (mongodb://127.0.0.1:27017/lilacui) or a free Atlas cluster.
# Leave empty to run without a database (nothing is saved or cached).
MONGODB_URI=

# Which AI writes the styles:
#   ollama  free, runs on this computer
#   gemini  free tier, needs GEMINI_API_KEY
#   claude  paid per request, needs ANTHROPIC_API_KEY
AI_PROVIDER=ollama

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Gemini: create a free key at https://aistudio.google.com (Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Claude: create a key at https://platform.claude.com (Settings > API keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Set to 1 when running behind a tunnel or proxy, so rate limits see real visitor IPs
TRUST_PROXY=0
